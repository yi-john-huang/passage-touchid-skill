#!/usr/bin/env python3
"""Emit validated, personal static Passage credentials for AWS credential_process."""

import json
import re
import subprocess
import sys

NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z", re.ASCII)
FIELDS = {"Version", "AccessKeyId", "SecretAccessKey"}
ERROR = "Credential process failed.\n"


def validate_static_credentials(data: bytes) -> dict:
    """Return only a complete static Version-1 object or raise ValueError."""
    try:
        record = json.loads(data)
    except (ValueError, UnicodeError) as exc:
        raise ValueError("invalid credentials") from exc
    if not isinstance(record, dict) or record.keys() != FIELDS:
        raise ValueError("invalid credentials")
    if type(record["Version"]) is not int or record["Version"] != 1:
        raise ValueError("invalid credentials")
    if any(not isinstance(record[field], str) or not record[field]
           for field in ("AccessKeyId", "SecretAccessKey")):
        raise ValueError("invalid credentials")
    return {"Version": 1, "AccessKeyId": record["AccessKeyId"],
            "SecretAccessKey": record["SecretAccessKey"]}


def main() -> int:
    if len(sys.argv) != 2 or not NAME.fullmatch(sys.argv[1]):
        sys.stderr.write(ERROR)
        return 1
    try:
        result = subprocess.run(
            ["passage", "show", f"aws/{sys.argv[1]}"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False,
        )
        if result.returncode != 0:
            raise ValueError("unavailable credentials")
        validated = validate_static_credentials(result.stdout)
    except (OSError, ValueError):
        sys.stderr.write(ERROR)
        return 1
    sys.stdout.write(json.dumps(validated, separators=(",", ":")) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
